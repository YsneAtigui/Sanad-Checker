# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://sanad_user:sanad_password_2026@postgres:5432/sanad_db
POSTGRES_USER=sanad_user
POSTGRES_PASSWORD=sanad_password_2026
POSTGRES_DB=sanad_db

# =============================================================================
# REDIS & CELERY CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# OLLAMA LLM CONFIGURATION
# =============================================================================
# Using localhost Ollama (not containerized)
# host.docker.internal allows Docker containers to access host machine
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================
STORAGE_TYPE=local
STORAGE_PATH=/var/sanad/audits

# Optional: S3/MinIO Configuration (uncomment to use)
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=sanad-audits
# S3_REGION=us-east-1

# =============================================================================
# API SERVER CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
LOG_LEVEL=info

# Security - CHANGE IN PRODUCTION!
SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Add your frontend URL here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TTL_AUDIT=3600
CACHE_TTL_LIST=60
CACHE_TTL_PROTOCOL=300

# =============================================================================
# CELERY WORKER CONFIGURATION
# =============================================================================
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_TIMEOUT=300

# =============================================================================
# CRAWL4AI CONFIGURATION
# =============================================================================
# Browser configuration for Crawl4AI
CRAWL4AI_HEADLESS=true
CRAWL4AI_TIMEOUT=30
CRAWL4AI_MAX_RETRIES=3
# Database path for crawl4ai cache (must be writable)
CRAWL4AI_DB_PATH=/var/sanad/crawl4ai

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development
APP_NAME=Sanad AEO Auditor
APP_VERSION=1.0.0

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# Enable detailed SQL logging (development only)
SQL_ECHO=false
