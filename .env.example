# Database
DATABASE_URL=postgresql://sanad_user:changeme@localhost:5432/sanad_db
POSTGRES_USER=sanad_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sanad_db

# Redis/Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Storage (local filesystem for MVP)
STORAGE_TYPE=local
STORAGE_PATH=/var/sanad/audits

# Optional S3 (uncomment if using MinIO/S3)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=sanad-audits

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# CORS (for frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
